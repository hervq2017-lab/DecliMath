# E-mails (séparés par des virgules) qui deviennent administrateurs : accès à toutes les classes.
VITE_ADMIN_EMAILS=

# Tuteur conversationnel (lecture des images et de l écriture manuscrite). Variable SANS préfixe VITE_ : elle reste sur le serveur.
CODECRAFT_API_KEY=
# TUTOR_API_URL=https://codecraftapi.com/v1
# TUTOR_MODEL=gpt-5.5

# Scanner d'exercices (lecture du texte des images). Un fournisseur suffit ; sans aucun, la saisie manuelle reste proposée.
# OCR_PROVIDER=mathpix|vision   (sinon : Mathpix s'il est configuré, sinon le modèle de vision CODECRAFT_API_KEY)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
# OCR_MODEL=gpt-5.5

# Supabase : URL du projet et clé PUBLIQUE (anon / publishable). Jamais la clé service_role dans une variable VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clé serveur (comptes enfants) : sans préfixe VITE_, uniquement dans les variables Vercel.
# SUPABASE_SERVICE_ROLE_KEY=

# Paiement SasPay : clé marchande uniquement côté serveur (ne jamais utiliser VITE_).
# SASPAY_API_KEY=sk_test_... pour les tests, sk_live_... en production.
# APP_URL=https://votre-domaine.example
